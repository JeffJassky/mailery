# Environment for the live test tiers. Copy to `.env` and fill in.
# NOTHING here is needed for `yarn test` — the fast matrix runs fully offline.
# Values are read from the process environment; this file is a checklist, not
# something the suite loads. Never commit real credentials.

# --- Tier 2: live SendGrid ---------------------------------------------------

# Unset            → the entire live tier is skipped.
# sandbox          → real API calls, real auth and payload validation, nothing
#                    delivered, no quota spent. Start here.
# deliver          → real delivery. Requires the Gmail vars below.
MAILERY_LIVE_E2E=sandbox

# SendGrid API key with Mail Send permission. Required for either live mode.
SENDGRID_API_KEY=

# A sender address on a domain authenticated in SendGrid (SPF + DKIM).
# An unverified sender is rejected, which one of the live tests asserts.
SENDGRID_FROM_EMAIL=

# --- Tier 2: Gmail inbox verification (MAILERY_LIVE_E2E=deliver only) --------

# The receiving account. Tests use plus-tagging (user+<token>@gmail.com) so
# every run is isolable inside the one inbox.
GMAIL_USERNAME=

# Google app password, NOT the account password. Requires 2FA on the account:
# https://myaccount.google.com/apppasswords
GMAIL_PASSWORD=

# --- Real background workers (optional) --------------------------------------

# Set to run the live tier through real BullMQ workers instead of driving the
# runner by hand. This is the only configuration that exercises job delays,
# retries, backoff and the send rate limiter.
#   docker run -p 6379:6379 redis:7
MAILERY_TEST_REDIS_URL=
