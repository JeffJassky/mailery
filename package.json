{
  "name": "mailery",
  "version": "0.7.0",
  "description": "Embedded, MongoDB-backed email automation for Node.js. Triggered flows, broadcasts, tracking, suppression, and an admin UI you mount inside your Express app.",
  "license": "MIT",
  "author": "Jeff Jassky <jeff@jeffjassky.com>",
  "homepage": "https://jeffjassky.github.io/mailery/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffJassky/mailery.git"
  },
  "bugs": {
    "url": "https://github.com/JeffJassky/mailery/issues"
  },
  "keywords": [
    "email",
    "automation",
    "drip",
    "newsletter",
    "mongodb",
    "express",
    "self-hosted",
    "transactional",
    "mailerlite-alternative"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mailery": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "yarn build:server && yarn build:client",
    "build:server": "tsup",
    "build:client": "vite build --config src/client/vite.config.ts",
    "dev:server": "tsup --watch",
    "dev:client": "vite --config src/client/vite.config.ts",
    "dev:client:watch": "vite build --watch --config src/client/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit && tsc -p src/client/tsconfig.json",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "yarn clean && yarn typecheck && yarn test && yarn build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "@agendajs/mongo-backend": "^4.0.0",
    "agenda": "^6.2.0",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.0.0",
    "express": "^4.18.0 || ^5.0.0",
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@agendajs/mongo-backend": {
      "optional": true
    },
    "agenda": {
      "optional": true
    },
    "bottleneck": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agendajs/mongo-backend": "^4.0.2",
    "@playwright/test": "^1.60.0",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/ioredis-mock": "^8.2.7",
    "@types/mjml": "^5.0.0",
    "@types/mongodb": "^4.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "agenda": "^6.2.5",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.76.7",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "ioredis-mock": "^8.13.1",
    "mongodb-memory-server": "^11.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitepress": "^1.4.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@maily-to/core": "^0.3.7",
    "@maily-to/render": "^0.2.3",
    "@sendgrid/mail": "^8.1.6",
    "adm-zip": "^0.5.17",
    "fast-xml-parser": "^5.8.0",
    "handlebars": "^4.7.9",
    "html-to-text": "^10.0.0",
    "mjml": "^5.2.0",
    "mongodb": "^7.2.0",
    "multer": "^2.1.1",
    "psl": "^1.15.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zod": "^4.4.3"
  }
}
